# PegaNaFrota — variáveis de ambiente
# Copie para .env. O .env NUNCA é versionado (ver .gitignore e verify-no-secrets).

# ---- Backend (usado pelo build dos dois produtos) ---------------------------
PNF_SUPABASE_URL=http://localhost:54321
# Chave ANÔNIMA. É pública por natureza: identifica o projeto e não autoriza
# nada — quem autoriza é a RLS a partir do JWT do usuário.
PNF_SUPABASE_ANON_KEY=cole-aqui-a-anon-key

# ---- Edge Function `platform-admin` ----------------------------------------
# Definidas com `supabase secrets set`, NUNCA neste arquivo em produção.
# SUPABASE_SERVICE_ROLE_KEY é injetada pela plataforma; não a adicione à mão.
ADMIN_WEB_ORIGINS=http://localhost:5174
INVITE_TTL_HOURS=72
RESEND_COOLDOWN_SECONDS=300

# ---- Edge Function `admin-users` (gestão da equipe no Electron) ------------
# Se este secret for definido no projeto hospedado, inclua `null`: o renderer
# file:// do Electron envia Origin: null.
ADMIN_USERS_ALLOWED_ORIGINS=null,app://peganafrota,http://localhost:5173,http://127.0.0.1:5173

# Entrega de convite: `smtp` (produção) ou `log` (desenvolvimento — registra o
# link no log da função e NÃO envia e-mail).
INVITE_DELIVERY=log
INVITE_BASE_URL=http://localhost:5174
SMTP_RELAY_URL=
SMTP_RELAY_TOKEN=
INVITE_FROM=nao-responda@peganafrota.app
