{
  "name": "peganafrota",
  "version": "1.0.0",
  "private": true,
  "description": "PegaNaFrota — monorepo de produção (Desktop das empresas + Admin Web da plataforma)",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "compartilhado/permissoes-e-regras",
    "compartilhado/validacoes",
    "aplicativos/programa-empresa",
    "aplicativos/painel-administracao"
  ],
  "scripts": {
    "desktop": "node ferramentas/desenvolvimento/abrir-programa-empresa.mjs",
    "dev:stack": "bash ferramentas/desenvolvimento/pilha-local.sh up",
    "dev:stack:down": "bash ferramentas/desenvolvimento/pilha-local.sh down",
    "build": "npm run build:admin && npm run build:desktop",
    "build:admin": "node aplicativos/painel-administracao/compilar-aplicativo.mjs",
    "build:desktop": "node aplicativos/programa-empresa/compilar-aplicativo.mjs",
    "preview:admin": "node aplicativos/painel-administracao/abrir-visualizacao-local.mjs",
    "lint": "node ferramentas/verificacoes/analisar-codigo.mjs",
    "gate": "node ferramentas/verificacoes/verificar-projeto.mjs",
    "test:unit": "node ferramentas/testes/testar-unidades.mjs",
    "test:edge:unit": "node --experimental-strip-types --test supabase/tests/edge/admin-users.test.mjs",
    "test:contracts": "node ferramentas/verificacoes/verificar-contratos.mjs",
    "test:config": "node ferramentas/verificacoes/verificar-configuracao.mjs",
    "db:test": "bash ferramentas/testes/banco-local/testar-banco.sh",
    "db:reset": "bash ferramentas/testes/banco-local/preparar-banco.sh",
    "test:integration": "node ferramentas/testes/testar-integracao.mjs",
    "test:auth-real": "node ferramentas/testes/testar-autenticacao.mjs",
    "test:edge:integration": "node ferramentas/testes/testar-funcoes-servidor.mjs",
    "smoke:admin": "node aplicativos/painel-administracao/testes/teste-inicializacao-basica.mjs",
    "smoke:desktop": "node aplicativos/programa-empresa/testes/teste-inicializacao-basica.mjs",
    "test:e2e": "node ferramentas/testes/testar-programa-empresa.mjs && node ferramentas/testes/testar-painel-administracao.mjs",
    "test:e2e:desktop": "node ferramentas/testes/testar-programa-empresa.mjs",
    "test:e2e:admin": "node ferramentas/testes/testar-painel-administracao.mjs",
    "visual": "npm run visual:routes && npm run visual:similarity",
    "visual:routes": "node ferramentas/testes/capturar-telas.mjs",
    "visual:similarity": "node ferramentas/testes/comparar-telas.mjs",
    "verify:secrets": "node ferramentas/verificacoes/verificar-segredos.mjs .",
    "verify:no-cdn": "node ferramentas/verificacoes/verificar-recursos-locais.mjs",
    "verify:prototype": "node ferramentas/verificacoes/verificar-prototipos.mjs",
    "verify:boundaries": "node ferramentas/verificacoes/verificar-fronteiras.mjs",
    "verify:electron": "node ferramentas/verificacoes/verificar-electron.mjs",
    "report:counts": "node ferramentas/verificacoes/contar-arquivos.mjs",
    "platform:bootstrap": "node ferramentas/administracao/criar-administrador-inicial.mjs",
    "platform:replace": "node ferramentas/administracao/substituir-administrador.mjs",
    "seed:remote": "node ferramentas/administracao/preparar-demonstracao.mjs",
    "seed:verify": "node ferramentas/administracao/verificar-demonstracao.mjs",
    "deploy:functions": "npx supabase functions deploy platform-admin && npx supabase functions deploy admin-users",
    "backend:verify": "node ferramentas/administracao/verificar-backend.mjs",
    "test:refactor": "node ferramentas/verificacoes/verificar-organizacao.mjs",
    "abrir:empresa": "node ferramentas/desenvolvimento/abrir-programa-empresa.mjs",
    "compilar": "npm run build:admin && npm run build:desktop",
    "compilar:empresa": "node aplicativos/programa-empresa/compilar-aplicativo.mjs",
    "compilar:painel": "node aplicativos/painel-administracao/compilar-aplicativo.mjs",
    "abrir:painel": "node aplicativos/painel-administracao/abrir-visualizacao-local.mjs",
    "testar": "node ferramentas/testes/testar-unidades.mjs",
    "verificar:organizacao": "node ferramentas/verificacoes/verificar-organizacao.mjs",
    "gerar:instalador": "node ferramentas/compilacao/gerar-instalador.mjs",
    "compilar:vercel": "node ferramentas/compilacao/compilar-painel-vercel.mjs"
  },
  "devDependencies": {
    "electron-builder": "^26.15.3",
    "pixelmatch": "^6.0.0",
    "pngjs": "^7.0.0",
    "pg": "8.16.3"
  },
  "type": "module"
}
